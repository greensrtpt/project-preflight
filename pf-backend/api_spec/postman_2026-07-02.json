          "name": "Get All Groups by Topic",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/groups/{{topic_id}}"
          }
        },
        {
          "name": "Get One Group",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/groups/{{topic_id}}/{{group_id}}"
          }
        },
        {
          "name": "Create Group",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group_name\": \"Computer Science\"\n}"
            },
            "url": "{{base_url}}/groups/{{topic_id}}"
          }
        },
        {
          "name": "Delete Group",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/groups/{{topic_id}}/{{group_id}}"
          }
        }
      ]
    },
