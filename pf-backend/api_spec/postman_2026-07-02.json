  "item": [
    {
      "name": "Topics",
      "item": [
        {
          "name": "Get All Topics",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/topics/all"
          }
        },
        {
          "name": "Get One Topic",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/topics/{{topic_id}}"
          }
        },
        {
          "name": "Delete Topic",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/topics/{{topic_id}}"
          }
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
