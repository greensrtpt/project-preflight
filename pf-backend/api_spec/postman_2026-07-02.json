        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/users/{{user_id}}"
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Post\",\n  \"descriptions\": \"Test post description\"\n}"
            },
            "url": "{{base_url}}/posts/{{group_id}}"
          }
        },
        {
          "name": "Get All Posts by Group",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/posts/{{group_id}}"
          }
        },
        {
          "name": "Get One Post",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/posts/{{group_id}}/{{post_id}}"
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Post\",\n  \"descriptions\": \"Updated post description\"\n}"
            },
            "url": "{{base_url}}/posts/{{group_id}}/{{post_id}}"
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
